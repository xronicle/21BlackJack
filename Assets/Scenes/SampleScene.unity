      m_Calls: []
  m_text: "\u0418\u0433\u0440\u0430 \"21\" (\u0411\u043B\u044D\u043A\u0434\u0436\u0435\u043A)\n\n\u0410\u0432\u0442\u043E\u0440:
    \u041C\u0430\u043A\u0441\u0438\u043C \u041A\u043E\u0440\u043E\u0442\u043A\u043E\u0432,
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442 \u0433\u0440\u0443\u043F\u043F\u044B
    8\u041A43\n\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\n\n\u041F\u0440\u0430\u0432\u0438\u043B\u0430
    \u0438\u0433\u0440\u044B:\n\n- \u0426\u0435\u043B\u044C: \u043D\u0430\u0431\u0440\u0430\u0442\u044C
    \u043E\u0447\u043A\u0438 \u0431\u043B\u0438\u0436\u0435 \u043A 21, \u043D\u043E
    \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435.\n- \u041A\u0430\u0440\u0442\u044B
    \u0441 2 \u0434\u043E 10 \u0441\u0442\u043E\u044F\u0442 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0441\u0432\u043E\u0435\u043C\u0443 \u043D\u043E\u043C\u0438\u043D\u0430\u043B\u0443.\n-
    \u0422\u0443\u0437\u044B - 11 \u043E\u0447\u043A\u043E\u0432.\n- \u0412\u0430\u043B\u0435\u0442\u044B,
    \u0434\u0430\u043C\u044B \u0438 \u043A\u043E\u0440\u043E\u043B\u0438 \u0438\u043C\u0435\u044E\u0442
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    (\u0432\u0430\u043B\u0435\u0442 - 2, \u0434\u0430\u043C\u0430 - 3, \u043A\u043E\u0440\u043E\u043B\u044C
    - 4).\n- \u0414\u0432\u0430 \u0442\u0443\u0437\u0430 \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442
    \u0443 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u0441 \u0441\u0443\u043C\u043C\u043E\u0439
    21.\n- \u0418\u0433\u0440\u043E\u043A \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
    \u0441 \u0434\u0432\u0443\u043C\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438
    \u0438 \u043C\u043E\u0436\u0435\u0442 \u0431\u0440\u0430\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435.\n-
    \u0415\u0441\u043B\u0438 \u0441\u0443\u043C\u043C\u0430 \u043E\u0447\u043A\u043E\u0432
    \u0438\u0433\u0440\u043E\u043A\u0430 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442
    21 - \u043E\u043D \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442.\n-
    \u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0442\u043E\u0442, \u0443
    \u043A\u043E\u0433\u043E \u0441\u0443\u043C\u043C\u0430 \u043E\u0447\u043A\u043E\u0432
    \u0431\u043B\u0438\u0436\u0435 \u043A 21 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u0430.\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0437\u0430 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435! \u0425\u043E\u0440\u043E\u0448\u0435\u0439
    \u0438\u0433\u0440\u044B!\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0430\u0441\u0441\u0435\u0442\u044B:\n\u041A\u0430\u0440\u0442\u044B \u2014
    IvoryRed, itch.io: https://ivoryred.itch.io/pixel-poker-cards\r\n\u0428\u0440\u0438\u0444\u0442
    \"Public Pixel\" \u2014 https://www.fonts.uprock.ru/fonts/public-pixel\r\n\u0424\u043E\u043D
    \u2014 Freepik, https://www.freepik.com/free-vector/flat-design-poker-table-background_88532181.htm"
  m_isRightToLeft: 0
